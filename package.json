{
  "name": "quadra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "gate": "npm run typecheck && npm run test:cov && npm run build",
    "measure": "vite-node scripts/measure-catalog.ts",
    "smoke": "vite-node scripts/smoke-skills.ts --",
    "build:mcp": "node scripts/build-mcp.mjs",
    "contracts:build": "cd contracts && base-forge build",
    "contracts:test": "cd contracts && base-forge test",
    "contracts:cov": "vite-node scripts/check-contract-coverage.ts",
    "gate:contracts": "npm run contracts:build && npm run contracts:test && npm run contracts:cov"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.4.0",
    "@walletconnect/ethereum-provider": "^2.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.170.0",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@uniswap/v4-core": "^1.0.2",
    "@uniswap/v4-periphery": "^1.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
