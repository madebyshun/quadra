# Coinbase CDP facilitator — verifies and settles the EIP-3009 authorization.
# Server-side only. Never expose to the client, never commit the real values.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Where off-chain x402 revenue settles. Must be a wallet whose key you hold.
# Leave blank until the wallet exists; the code throws rather than guessing.
QUADRA_TREASURY=

# Base RPC. Public endpoint works; a keyed one is faster.
BASE_RPC_URL=https://mainnet.base.org
